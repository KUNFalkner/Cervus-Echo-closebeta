# 鹿鸣回音后端环境变量示例
# 复制本文件为 .env 后填入真实值（.env 已被 .gitignore 排除，不会入库）

# ===== JWT 签名密钥（上线前必改，务必随机且保密）=====
# 生成方式（任选其一）：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
#   openssl rand -base64 48
# 注意：修改 SECRET 会使所有已签发的 token 失效，用户需重新登录
TREEHOLE_SECRET=change-me-to-a-long-random-string

# ===== 运行环境：dev（默认）| prod =====
# prod 模式下若未设置 TREEHOLE_SECRET 将直接启动失败（防止误用开发密钥）
TREEHOLE_ENV=dev

# ===== CORS 允许的源（逗号分隔，留空则默认放行本地 5173）=====
# 部署到 https://your.domain 时填入该域名，例如：
# TREEHOLE_ORIGINS=https://your.domain
TREEHOLE_ORIGINS=

# ===== 微信登录（可选，不配则登录页隐藏微信入口）=====
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ===== 塔罗 AI 咨询师（可选，不配则使用内置规则式解读）=====
# 任意 OpenAI 兼容的 /chat/completions 接口。留空即走内置解读。
TAROT_LLM_API_KEY=
# 自定义网关（如 DeepSeek / 通义 / 本地 Ollama 等），默认官方 OpenAI
TAROT_LLM_BASE_URL=https://api.openai.com/v1
# 模型名（默认 gpt-4o-mini）
TAROT_LLM_MODEL=gpt-4o-mini
